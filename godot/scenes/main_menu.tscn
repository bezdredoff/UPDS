[sub_resource type="Shader" id="Shader_backdrop"]
code = "shader_type canvas_item;\nvoid fragment() {\n\tvec2 point = UV - vec2(0.5, 0.0);\n\tfloat distance_from_center = length(point) + UV.y * 0.65;\n\tfloat shade = smoothstep(0.35, 1.05, distance_from_center);\n\tCOLOR = mix(vec4(0.333, 0.318, 0.431, 1.0), vec4(0.09, 0.102, 0.184, 1.0), shade);\n}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_backdrop"]
