      "localized": {
        "ru": {
          "speaker": "АЮКИ",
          "emotion": "СЕРЬЁЗНЕЕТ",
          "text": "В каждый день, когда появлялась новая анонимная подсказка?"
        },
        "en": {
          "speaker": "AYUKI",
          "emotion": "BEAT",
          "text": "On every day with a new anonymous lead?"
        },
        "be": {
          "speaker": "АЮКІ",
          "emotion": "СТАНОВІЦЦА СУР'ЁЗНЕЙ",
          "text": "У кожны дзень з новай ананімнай падказкай?"
        }
      }
    },
    {
      "id": "VN0720",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ABANDONED_LAUNDRY.webp",
      "actors": [
        {
          "character": "onoe",
          "asset": "./assets/characters/onoe/rig/pose_a/frames/frame-neutral.png",
          "x": 29,
          "top": 37.9,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "СВЕРЯЕТ ВРЕМЯ",
          "text": "Во все дни, за которые сохранились записи. Но пока это доказывает лишь её присутствие, а не авторство записок или мотив."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "BEAT",
          "text": "On every preserved day. But that proves her presence, not authorship of the notes or motive."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "ЗВЯРАЕ ЧАС",
          "text": "За ўсе даты, для якіх захаваліся запісы. Але гэта даказвае толькі яе прысутнасць, не аўтарства запісак і не матыў."
        }
      }
    },
