      ],
      "localized": {
        "ru": {
          "speaker": "МИКУ",
          "emotion": "ФИКСИРУЕТ УЛИКУ",
          "text": "Кто-то с доступом к старой прачечной знает о Second Skin, знает, на что соглашались участники, и сознательно направляет расследование сюда."
        },
        "en": {
          "speaker": "MIKU",
          "emotion": "BEAT",
          "text": "Someone with access to the old laundry knows about Second Skin, knows about participant consent, and deliberately led the investigation here."
        },
        "be": {
          "speaker": "МІКУ",
          "emotion": "ФІКСУЕ ЎЛІКУ",
          "text": "Нехта з доступам да старой пральні ведае пра Second Skin, ведае, на што згаджаліся ўдзельнікі, і свядома накіроўвае расследаванне сюды."
        }
      }
    },
