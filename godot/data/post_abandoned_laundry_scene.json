        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "ЗАКРЫВАЕТ ШКАФ",
          "text": "Завтра узнаем. Сегодня у нас есть маршрут, доступ и вопрос о согласии."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "BEAT",
          "text": "Tomorrow we find out. Today we have a route, access, and the question of consent."
