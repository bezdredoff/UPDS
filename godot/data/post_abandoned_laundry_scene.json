      "actors": [],
      "localized": {
        "ru": {
          "speaker": "РЕЖИССУРА",
          "emotion": "SFX: PHONE MESSAGE",
          "text": "На телефон клуба приходит новое анонимное сообщение с одним адресом и временем."
        },
        "en": {
          "speaker": "DIRECTION",
          "emotion": "SFX: PHONE MESSAGE",
          "text": "The club phone receives another anonymous message before they leave."
        },
        "be": {
          "speaker": "РЭЖЫСУРА",
          "emotion": "SFX: PHONE MESSAGE",
          "text": "На тэлефон клуба прыходзіць новае ананімнае паведамленне з адным адрасам і часам."
        }
      }
    },
    {
      "id": "VN0723",
      "hidden": true,
      "background": "./assets/backgrounds/BG_ABANDONED_LAUNDRY.webp",
      "actors": [],
      "localized": {
        "ru": {
          "speaker": "СИСТЕМА",
          "emotion": "MESSAGE",
          "text": "«Если хотите понять, зачем она искала метки, проверьте розовые ленты. Завтра, 18:30.»"
        },
        "en": {
          "speaker": "SYSTEM",
          "emotion": "MESSAGE",
          "text": "‘If you want to understand why she searched for the tags, check the pink ribbons. Tomorrow, 18:30.’"
        },
        "be": {
          "speaker": "СІСТЭМА",
          "emotion": "MESSAGE",
          "text": "«Калі хочаце зразумець, навошта яна шукала меткі, праверце ружовыя стужкі. Заўтра, 18:30.»"
        }
      }
    },
