      ],
      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "ПОКАЗЫВАЕТ СТАРУЮ КАМЕРУ",
          "text": "Здесь осталась локальная камера двора. Архив короткий, но кадры за последние недели сохранились."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "BEAT",
          "text": "There is an old local yard camera. The archive is short, but footage from recent weeks survived."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "ПАКАЗВАЕ СТАРУЮ КАМЕРУ",
          "text": "Тут засталася лакальная камера двара. Архіў кароткі, але кадры за апошнія тыдні захаваліся."
        }
      }
    },
    {
      "id": "VN0717",
      "hidden": true,
      "background": "./assets/backgrounds/BG_ABANDONED_LAUNDRY.webp",
      "actors": [],
      "localized": {
        "ru": {
          "speaker": "РЕЖИССУРА",
          "emotion": "INSERT: YARD PHOTO STRIP",
          "text": "На нескольких кадрах у корпуса появляется одна и та же фигура в форме вечерней смены прачечной."
        },
        "en": {
          "speaker": "DIRECTION",
          "emotion": "INSERT: YARD PHOTO STRIP",
          "text": "Across several frames, the same figure in an evening-laundry uniform appears by the building."
        },
        "be": {
          "speaker": "РЭЖЫСУРА",
          "emotion": "INSERT: YARD PHOTO STRIP",
          "text": "На некалькіх кадрах каля корпуса з'яўляецца адна і тая ж постаць у форме вячэрняй змены пральні."
        }
      }
