  "lines": [
    {
      "id": "VN0708",
      "hidden": true,
      "background": "./assets/backgrounds/BG_ABANDONED_LAUNDRY.webp",
      "actors": [],
      "localized": {
        "ru": {
          "speaker": "РЕЖИССУРА",
          "emotion": "INSERT: OPEN SERVICE CABINET",
          "text": "За мусором открывается старый шкаф. Внутри — действующая ключ-карта, пустая упаковка Asterion и свежая сервисная наклейка."
        },
        "en": {
          "speaker": "DIRECTION",
          "emotion": "INSERT: OPEN SERVICE CABINET",
          "text": "Behind the debris, the old cabinet opens. Inside are an active key card, empty Asterion packaging, and a fresh service sticker."
        },
        "be": {
          "speaker": "РЭЖЫСУРА",
          "emotion": "INSERT: OPEN SERVICE CABINET",
          "text": "За смеццем адкрываецца старая шафа. Унутры — дзейная ключ-карта, пустая ўпакоўка Asterion і свежая сэрвісная налепка."
        }
      }
    },
    {
      "id": "VN0709",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ABANDONED_LAUNDRY.webp",
      "actors": [
        {
          "character": "onoe",
          "asset": "./assets/characters/onoe/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 37.9,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "ПРОВЕРЯЕТ КАРТУ",
          "text": "Карта активна. Её журнал показывает проходы в те же ночи, когда появлялись анонимные подсказки."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "BEAT",
          "text": "The card is active. Its log shows entries on the same nights when anonymous leads appeared."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "ПРАВЯРАЕ КАРТУ",
          "text": "Карта актыўная. Яе журнал паказвае праходы ў тыя ж ночы, калі з'яўляліся ананімныя падказкі."
        }
      }
    },
    {
      "id": "VN0710",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ABANDONED_LAUNDRY.webp",
      "actors": [
        {
          "character": "miku",
          "asset": "./assets/characters/miku/rig/pose_a/frames/frame-neutral.png",
          "x": 29,
          "top": 37.14,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "МИКУ",
          "emotion": "СРАВНИВАЕТ ПАКЕТ",
          "text": "А помеченный образец относится к новому случаю. Значит, маршрут используется сейчас, не только исторически."
        },
        "en": {
          "speaker": "MIKU",
          "emotion": "BEAT",
          "text": "And the marked sample belongs to a new case. The route is being used now, not only historically."
        },
        "be": {
          "speaker": "МІКУ",
          "emotion": "ПАРАЎНОЎВАЕ ПАКЕТ",
          "text": "А пазначаны ўзор адносіцца да новага выпадку. Значыць, маршрут выкарыстоўваецца цяпер, а не толькі гістарычна."
        }
      }
    },
    {
      "id": "VN0711",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ABANDONED_LAUNDRY.webp",
      "actors": [
        {
          "character": "ayuki",
          "asset": "./assets/characters/ayuki/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 33.39,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "АЮКИ",
          "emotion": "СМОТРИТ НА РЭЯ",
          "text": "Кот только что нашёл действующий тайный проход быстрее нас."
        },
        "en": {
          "speaker": "AYUKI",
          "emotion": "BEAT",
          "text": "The cat just found an active secret route faster than we did."
        },
        "be": {
          "speaker": "АЮКІ",
          "emotion": "ГЛЯДЗІЦЬ НА РЭЯ",
          "text": "Кот толькі што знайшоў дзейны тайны праход хутчэй за нас."
        }
      }
    },
    {
      "id": "VN0712",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ABANDONED_LAUNDRY.webp",
      "actors": [
        {
          "character": "onoe",
          "asset": "./assets/characters/onoe/rig/pose_a/frames/frame-neutral.png",
          "x": 29,
          "top": 37.9,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "ПОПРАВЛЯЕТ",
          "text": "Кот переместил пакет по неизвестной мотивации. Проход нашли мы."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "BEAT",
          "text": "The cat moved a bag for unknown reasons. We found the route."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "ПАПРАЎЛЯЕ",
          "text": "Кот перамясціў пакет з невядомай матывацыяй. Праход знайшлі мы."
        }
      }
    },
    {
      "id": "VN0713",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ABANDONED_LAUNDRY.webp",
      "actors": [
        {
          "character": "ayuki",
          "asset": "./assets/characters/ayuki/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 33.39,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "АЮКИ",
          "emotion": "РЭЮ",
          "text": "Не позволяй ей переписывать историю."
        },
        "en": {
          "speaker": "AYUKI",
          "emotion": "BEAT",
          "text": "Do not let her rewrite history."
        },
        "be": {
          "speaker": "АЮКІ",
          "emotion": "РЭЮ",
          "text": "Не дазваляй ёй перапісваць гісторыю."
        }
      }
    },
    {
      "id": "VN0714",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ABANDONED_LAUNDRY.webp",
      "actors": [
        {
          "character": "miku",
          "asset": "./assets/characters/miku/rig/pose_a/frames/frame-neutral.png",
