      ],
      "localized": {
        "ru": {
          "speaker": "АЮКИ",
          "emotion": "ПРОБУЕТ ВЕРСИЮ",
          "text": "А если появился подражатель и решил расширить ассортимент?"
        },
        "en": {
          "speaker": "AYUKI",
          "emotion": "TESTING A THEORY",
          "text": "What if a copycat appeared and decided to broaden the selection?"
        },
        "be": {
          "speaker": "АЮКІ",
          "emotion": "ПРАБУЕ ВЕРСІЮ",
          "text": "А калі з'явіўся пераймальнік і вырашыў пашырыць асартымент?"
        }
      }
    },
    {
      "id": "VN0515",
      "hidden": false,
      "background": "./assets/backgrounds/BG_COMBAT_CLUB_HALL.webp",
      "actors": [
        {
          "character": "onoe",
          "asset": "./assets/characters/onoe/rig/pose_a/frames/frame-neutral.png",
          "x": 29,
          "top": 37.9,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
