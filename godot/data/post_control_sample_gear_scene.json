  "lines": [
    {
      "id": "VN0509",
      "hidden": true,
      "background": "./assets/backgrounds/BG_COMBAT_CLUB_HALL.webp",
      "actors": [],
      "localized": {
        "ru": {
          "speaker": "РЕЖИССУРА",
          "emotion": "INSERT: SORTED GEAR",
          "text": "Экипировка разложена на проверенные группы. Напульсник и защитный топ лежат рядом под увеличителем."
        },
        "en": {
          "speaker": "DIRECTION",
          "emotion": "INSERT: SORTED GEAR",
          "text": "The equipment is sorted into verified groups. The wristband and protective top sit side by side under a magnifier."
        },
        "be": {
          "speaker": "РЭЖЫСУРА",
          "emotion": "INSERT: SORTED GEAR",
          "text": "Экіпіроўка раскладзена па правераных групах. Напульснік і ахоўны топ ляжаць побач пад павелічальным шклом."
        }
      }
    },
    {
      "id": "VN0510",
      "hidden": false,
      "background": "./assets/backgrounds/BG_COMBAT_CLUB_HALL.webp",
      "actors": [
        {
          "character": "onoe",
          "asset": "./assets/characters/onoe/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 37.9,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "ПОДТВЕРЖДАЕТ",
          "text": "Одинаковая серебристая нить, одинаковый шаг шва. И оба предмета относятся к внешней экипировке."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "CONFIRMING",
          "text": "Same silver thread, same stitch pitch. And both items are outer equipment."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "ПАЦВЯРДЖАЕ",
          "text": "Аднолькавая серабрыстая нітка, аднолькавы крок шва. І абодва прадметы належаць да знешняй экіпіроўкі."
        }
      }
    },
    {
      "id": "VN0511",
      "hidden": false,
      "background": "./assets/backgrounds/BG_COMBAT_CLUB_HALL.webp",
      "actors": [
        {
          "character": "aoi",
          "asset": "./assets/guests/aoi/neutral.png",
          "x": 71,
          "top": 0,
          "height": 178,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 2,
          "idle": false
        }
      ],
      "localized": {
        "ru": {
          "speaker": "АОЙ",
          "emotion": "ХМУРИТСЯ",
          "text": "То есть дело уже не только в белье."
        },
        "en": {
          "speaker": "AOI",
          "emotion": "FROWNING",
          "text": "So this is no longer only about underwear."
        },
        "be": {
          "speaker": "АОІ",
          "emotion": "ХМУРЫЦЦА",
          "text": "Значыць, справа ўжо не толькі ў бялізне."
        }
      }
    },
    {
      "id": "VN0512",
      "hidden": false,
      "background": "./assets/backgrounds/BG_COMBAT_CLUB_HALL.webp",
      "actors": [
        {
          "character": "miku",
          "asset": "./assets/characters/miku/rig/pose_a/frames/frame-neutral.png",
          "x": 29,
          "top": 37.14,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "МИКУ",
          "emotion": "ТОЧНО",
          "text": "Бельё остаётся основной выборкой, но не единственной. Контрольные вещи подтверждают технический критерий, а не вкус похитителя."
        },
        "en": {
          "speaker": "MIKU",
          "emotion": "PRECISE",
          "text": "Underwear remains the primary sample, but not the only one. Control items support a technical criterion, not the thief’s taste."
        },
        "be": {
          "speaker": "МІКУ",
          "emotion": "ДАКЛАДНА",
          "text": "Бялізна застаецца асноўнай выбаркай, але не адзінай. Кантрольныя рэчы пацвярджаюць тэхнічны крытэрый, а не густ выкрадальніка."
        }
      }
    },
    {
      "id": "VN0513",
      "hidden": false,
      "background": "./assets/backgrounds/BG_COMBAT_CLUB_HALL.webp",
      "actors": [
        {
          "character": "kentaro",
          "asset": "./assets/characters/kentaro/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 39.81,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "КЭНТАРО",
          "emotion": "ЛИСТАЕТ ФОТО",
          "text": "На старых снимках у клуба уже были такие же сервисные ярлыки. И вот здесь — контейнер на заднем плане."
        },
        "en": {
          "speaker": "KENTARO",
          "emotion": "FLIPPING THROUGH PHOTOS",
          "text": "The club already had the same service tags in older photos. And here — there is a container in the background."
        },
        "be": {
          "speaker": "КЭНТАРО",
          "emotion": "ГАРТАЕ ФОТА",
          "text": "На старых здымках клуба ўжо былі такія ж сэрвісныя біркі. І вось тут — кантэйнер на заднім плане."
        }
      }
    },
    {
      "id": "VN0514",
      "hidden": false,
      "background": "./assets/backgrounds/BG_COMBAT_CLUB_HALL.webp",
      "actors": [
        {
          "character": "ayuki",
          "asset": "./assets/characters/ayuki/rig/pose_a/frames/frame-neutral.png",
          "x": 29,
          "top": 33.39,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
