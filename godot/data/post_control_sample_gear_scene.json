          "speaker": "МИКУ",
          "emotion": "ФИКСИРУЕТ УЛИКУ",
          "text": "Система затрагивает бельё как основной сенсорный слой и внешнюю экипировку как контрольную выборку."
        },
        "en": {
          "speaker": "MIKU",
          "emotion": "RECORDING CLUE",
