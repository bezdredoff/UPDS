        }
      ],
      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "ПАУЗА",
          "text": "Заявление почти готово."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "PAUSE",
          "text": "The application is almost ready."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "ПАЎЗА",
          "text": "Заяўка амаль гатовая."
        }
      }
    },
    {
      "id": "VN0020",
      "hidden": false,
      "actors": [
