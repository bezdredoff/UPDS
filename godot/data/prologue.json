          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "МИКУ",
          "emotion": "РАССМАТРИВАЕТ ТАБЛИЧКУ",
          "text": "А официальный статус у клуба есть?"
        },
        "en": {
          "speaker": "MIKU",
          "emotion": "LOOKS AT THE SIGN",
          "text": "Does the club have official status?"
        },
        "be": {
          "speaker": "МІКУ",
          "emotion": "РАЗГЛЯДАЕ ТАБЛІЧКУ",
          "text": "А афіцыйны статус у клуба ёсць?"
        }
      }
    },
    {
      "id": "VN0019",
      "hidden": false,
      "actors": [
        {
          "character": "onoe",
          "asset": "./assets/characters/onoe/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
