          "z": 3
        },
        {
          "character": "ayuki",
          "asset": "./assets/characters/ayuki/rig/pose_a/frames/frame-smile.png",
          "x": 82,
          "top": 33.39,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 2
        }
      ],
      "localized": {
        "ru": {
          "speaker": "МИКУ",
          "emotion": "УДИВЛЁННАЯ",
          "text": "Вы ещё не голосовали."
        },
        "en": {
          "speaker": "MIKU",
          "emotion": "SURPRISED",
          "text": "You have not voted yet."
        },
        "be": {
          "speaker": "МІКУ",
          "emotion": "ЗДЗІЎЛЕНАЯ",
          "text": "Вы яшчэ не галасавалі."
        }
      }
    },
    {
      "id": "VN0014",
      "hidden": false,
      "actors": [
        {
          "character": "onoe",
          "asset": "./assets/characters/onoe/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 37.9,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "НЕЙТРАЛЬНАЯ",
          "text": "Нас двое. Единогласие возникает быстро."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "NEUTRAL",
          "text": "There are two of us. Unanimity happens quickly."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "НЕЙТРАЛЬНАЯ",
          "text": "Нас двое. Аднагалоссе ўзнікае хутка."
        }
      }
    },
    {
      "id": "VN0015",
      "hidden": false,
      "actors": [
        {
          "character": "miku",
          "asset": "./assets/characters/miku/rig/pose_a/frames/frame-neutral.png",
          "x": 50,
          "top": 37.14,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "МИКУ (МЫСЛИ)",
          "emotion": "ИРОНИЧНАЯ",
          "text": "Я пришла рисовать афишу. Через сорок секунд получила должность."
        },
        "en": {
          "speaker": "MIKU (THOUGHTS)",
          "emotion": "IRONIC",
          "text": "I came to draw a poster. Forty seconds later I had a position."
        },
        "be": {
          "speaker": "МІКУ (ДУМКІ)",
          "emotion": "ІРАНІЧНАЯ",
          "text": "Я прыйшла маляваць афішу. Праз сорак секунд атрымала пасаду."
        }
      }
    },
    {
      "id": "VN0016",
      "hidden": false,
      "actors": [
        {
          "character": "ayuki",
          "asset": "./assets/characters/ayuki/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 33.39,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "АЮКИ",
          "emotion": "С ЛИСТОМ",
          "text": "Осталось выбрать название: «Око Сэйрана», «Три алиби» или «Красотки дедукции»."
        },
        "en": {
          "speaker": "AYUKI",
          "emotion": "HOLDING A SHEET",
          "text": "We only need a name: “The Eye of Seiran”, “Three Alibis”, or “Beauties of Deduction”."
        },
        "be": {
          "speaker": "АЮКІ",
          "emotion": "З ЛІСТОМ",
          "text": "Засталося выбраць назву: «Вока Сэйрана», «Тры алібі» або «Красуні дэдукцыі»."
        }
      }
    },
    {
      "id": "VN0017",
      "hidden": false,
      "actors": [
        {
          "character": "onoe",
          "asset": "./assets/characters/onoe/rig/pose_a/frames/frame-serious.png",
          "x": 29,
          "top": 37.9,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "ХОЛОДНО",
          "text": "Последнее название снижает нашу доказательную ценность."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "COLD",
          "text": "The last name reduces our evidentiary value."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "ХОЛАДНА",
          "text": "Апошняя назва зніжае нашу доказную каштоўнасць."
        }
      }
    },
    {
      "id": "VN0018",
      "hidden": false,
      "actors": [
        {
          "character": "miku",
          "asset": "./assets/characters/miku/rig/pose_a/frames/frame-neutral.png",
          "x": 29,
          "top": 37.14,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
