  "lines": [
    {
      "id": "VN0391",
      "hidden": true,
      "background": "./assets/backgrounds/BG_ASTERION_SMART_TEXTILE_LAB.webp",
      "actors": [],
      "localized": {
        "ru": {
          "speaker": "РЕЖИССУРА",
          "emotion": "INSERT: ANALYZER RESULT",
          "text": "Прибор выводит совпадение состава и покрытия. Серийная группа подсвечена рядом с лабораторным реестром."
        },
        "en": {
          "speaker": "DIRECTION",
          "emotion": "INSERT: ANALYZER RESULT",
          "text": "The analyzer reports a composition and coating match. The serial group is highlighted beside the lab registry."
        },
        "be": {
          "speaker": "РЭЖЫСУРА",
          "emotion": "INSERT: ANALYZER RESULT",
          "text": "Прыбор паказвае супадзенне складу і пакрыцця. Серыйная група падсвечана побач з лабараторным рэестрам."
        }
      }
    },
    {
      "id": "VN0392",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ASTERION_SMART_TEXTILE_LAB.webp",
      "actors": [
        {
          "character": "kurose",
          "asset": "./assets/characters/kurose/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 39.98,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "КУРОСЭ",
          "emotion": "ПОДТВЕРЖДАЕТ",
          "text": "Совпадение достаточное. Нить действительно из поставки Asterion."
        },
        "en": {
          "speaker": "KUROSE",
          "emotion": "CONFIRMING",
          "text": "The match is sufficient. The thread is indeed from an Asterion shipment."
        },
        "be": {
          "speaker": "КУРОСЭ",
          "emotion": "ПАЦВЯРДЖАЕ",
          "text": "Супадзення дастаткова. Нітка сапраўды з пастаўкі Asterion."
        }
      }
    },
    {
      "id": "VN0393",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ASTERION_SMART_TEXTILE_LAB.webp",
      "actors": [
        {
          "character": "onoe",
          "asset": "./assets/characters/onoe/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 37.9,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "ЛИСТАЕТ РЕЕСТР",
          "text": "Внешняя форма, тренировочные ремни, два прототипа компрессионной майки."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "SCANNING REGISTRY",
          "text": "Outer uniforms, training straps, two compression-shirt prototypes."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "ГАРТАЕ РЭЕСТР",
          "text": "Верхняя форма, трэніровачныя рамяні, два прататыпы кампрэсійнай майкі."
        }
      }
    },
    {
      "id": "VN0394",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ASTERION_SMART_TEXTILE_LAB.webp",
      "actors": [
        {
          "character": "miku",
          "asset": "./assets/characters/miku/rig/pose_a/frames/frame-neutral.png",
          "x": 29,
          "top": 37.14,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "МИКУ",
          "emotion": "ИЩЕТ",
          "text": "Назначений на личное бельё нет. Вообще ни одного."
        },
        "en": {
          "speaker": "MIKU",
          "emotion": "SEARCHING",
          "text": "There are no assignments to personal underwear. None at all."
        },
        "be": {
          "speaker": "МІКУ",
          "emotion": "ШУКАЕ",
          "text": "Прызначэнняў на асабістую бялізну няма. Увогуле ніводнага."
        }
      }
    },
    {
      "id": "VN0395",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ASTERION_SMART_TEXTILE_LAB.webp",
      "actors": [
        {
          "character": "kurose",
          "asset": "./assets/characters/kurose/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 39.98,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "КУРОСЭ",
          "emotion": "НЕ СПОРИТ",
          "text": "Тогда открытый реестр не объясняет ваш образец. Он мог отставать от сервисной операции."
        },
        "en": {
          "speaker": "KUROSE",
          "emotion": "NOT ARGUING",
          "text": "Then the public registry does not explain your sample. It may lag behind a service operation."
        },
        "be": {
          "speaker": "КУРОСЭ",
          "emotion": "НЕ СПРАЧАЕЦЦА",
          "text": "Тады адкрыты рэестр не тлумачыць ваш узор. Ён мог адставаць ад сэрвіснай аперацыі."
        }
      }
    },
    {
      "id": "VN0396",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ASTERION_SMART_TEXTILE_LAB.webp",
      "actors": [
        {
          "character": "ayuki",
          "asset": "./assets/characters/ayuki/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 33.39,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "АЮКИ",
          "emotion": "ПРИЩУРИВАЕТСЯ",
          "text": "У каждого неудобного факта здесь есть очень удобное «мог»."
        },
        "en": {
          "speaker": "AYUKI",
          "emotion": "SQUINTING",
          "text": "Every inconvenient fact here seems to have a very convenient “could.”"
        },
        "be": {
          "speaker": "АЮКІ",
          "emotion": "ПРЫЖМУРВАЕЦЦА",
          "text": "У кожнага нязручнага факта тут ёсць вельмі зручнае «мог»."
        }
      }
    },
    {
      "id": "VN0397",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ASTERION_SMART_TEXTILE_LAB.webp",
      "actors": [
        {
          "character": "kurose",
          "asset": "./assets/characters/kurose/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 39.98,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "КУРОСЭ",
          "emotion": "СПОКОЙНО",
          "text": "Поэтому я дам вам выгрузку, а не попрошу поверить слову. Проверяйте."
        },
        "en": {
          "speaker": "KUROSE",
          "emotion": "CALM",
          "text": "That is why I will give you the export instead of asking you to trust my word. Check it."
        },
        "be": {
          "speaker": "КУРОСЭ",
          "emotion": "СПАКОЙНА",
          "text": "Таму я дам вам выгрузку, а не папрашу паверыць на слова. Правярайце."
        }
      }
    },
    {
      "id": "VN0398",
      "hidden": true,
      "background": "./assets/backgrounds/BG_ASTERION_SMART_TEXTILE_LAB.webp",
      "actors": [],
      "localized": {
        "ru": {
          "speaker": "РЕЖИССУРА",
          "emotion": "INSERT: SERIAL CODE",
          "text": "Оноэ увеличивает серийный код. Последние четыре цифры не совпадают ни с одной зарегистрированной поставкой колледжа."
        },
        "en": {
          "speaker": "DIRECTION",
          "emotion": "INSERT: SERIAL CODE",
          "text": "Onoe enlarges the serial code. The last four digits match no registered shipment to the college."
        },
        "be": {
          "speaker": "РЭЖЫСУРА",
          "emotion": "INSERT: SERIAL CODE",
          "text": "Оноэ павялічвае серыйны код. Апошнія чатыры лічбы не супадаюць ні з адной зарэгістраванай пастаўкай каледжа."
        }
      }
    },
    {
      "id": "VN0399",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ASTERION_SMART_TEXTILE_LAB.webp",
      "actors": [
        {
          "character": "onoe",
          "asset": "./assets/characters/onoe/rig/pose_a/frames/frame-serious.png",
          "x": 71,
          "top": 37.9,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "ХОЛОДНО-ЗАИНТЕРЕСОВАННАЯ",
          "text": "Партия существует в системе производителя, но формально никогда не поступала сюда."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "COOL, INTERESTED",
          "text": "The batch exists in the manufacturer’s system, but formally never arrived here."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "ХАЛОДНА-ЗАЦІКАЎЛЕНАЯ",
          "text": "Партыя існуе ў сістэме вытворцы, але фармальна ніколі сюды не паступала."
        }
      }
    },
    {
      "id": "VN0400",
      "hidden": false,
      "background": "./assets/backgrounds/BG_ASTERION_SMART_TEXTILE_LAB.webp",
      "actors": [
        {
          "character": "miku",
          "asset": "./assets/characters/miku/rig/pose_a/frames/frame-neutral.png",
          "x": 29,
          "top": 37.14,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "МИКУ",
          "emotion": "ФИКСИРУЕТ",
          "text": "Факт: нить Asterion. Факт: назначения на личные вещи нет. Объяснение про случайный ремонт пока только объяснение."
        },
        "en": {
          "speaker": "MIKU",
          "emotion": "RECORDING",
          "text": "Fact: Asterion thread. Fact: no assignment to personal items. The accidental-repair story is still only an explanation."
        },
        "be": {
          "speaker": "МІКУ",
          "emotion": "ФІКСУЕ",
          "text": "Факт: нітка Asterion. Факт: прызначэння на асабістыя рэчы няма. Тлумачэнне пра выпадковы рамонт пакуль толькі тлумачэнне."
        }
      }
    },
    {
