        "ru": {
          "speaker": "РЕЖИССУРА",
          "emotion": "INSERT: LAUNDRY CALENDAR",
          "text": "После сортировки на доске остаются только подтверждённые заявления и семь отметок центральной прачечной."
        },
        "en": {
          "speaker": "STAGE DIRECTION",
          "emotion": "INSERT: LAUNDRY CALENDAR",
          "text": "After sorting, only verified reports and seven central-laundry marks remain on the board."
        },
        "be": {
          "speaker": "РЭЖЫСУРА",
          "emotion": "INSERT: LAUNDRY CALENDAR",
          "text": "Пасля сартавання на дошцы застаюцца толькі пацверджаныя заявы і сем адзнак цэнтральнай пральні."
        }
      }
    },
