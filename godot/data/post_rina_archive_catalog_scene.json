        "ru": {
          "speaker": "РЕЖИССУРА",
          "emotion": "EPISODE CARD",
          "text": "«Эпизод 18 — Вор, который пытался остановить кражу»"
        },
        "en": {
          "speaker": "DIRECTION",
          "emotion": "EPISODE CARD",
          "text": "“Episode 18 — The Thief Who Tried to Stop the Theft”"
        },
        "be": {
          "speaker": "РЭЖЫСУРА",
          "emotion": "EPISODE CARD",
          "text": "«Эпізод 18 — Злодзей, які спрабаваў спыніць крадзеж»"
        }
      }
    }
