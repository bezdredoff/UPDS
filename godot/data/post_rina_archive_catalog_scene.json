  "lines": [
    {
      "id": "VN0786",
      "hidden": true,
      "background": "./assets/backgrounds/BG_OLD_ARCHIVE.webp",
      "actors": [],
      "localized": {
        "ru": {
          "speaker": "РЕЖИССУРА",
          "emotion": "INSERT: RESTORED CATALOG",
          "text": "Каталог совпадает с каждым подтверждённым случаем по владельцу, дате и коду метки."
        },
        "en": {
          "speaker": "DIRECTION",
          "emotion": "INSERT: RESTORED CATALOG",
          "text": "The catalog matches every confirmed case by owner, date, and tag code."
        },
        "be": {
          "speaker": "РЭЖЫСУРА",
          "emotion": "INSERT: RESTORED CATALOG",
          "text": "Каталог супадае з кожным пацверджаным выпадкам паводле ўладальніка, даты і кода меткі."
        }
      }
    },
    {
      "id": "VN0787",
      "hidden": false,
      "background": "./assets/backgrounds/BG_OLD_ARCHIVE.webp",
      "actors": [
        {
          "character": "onoe",
          "asset": "./assets/characters/onoe/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 37.9,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "УВЕРЕННО",
          "text": "Пропавшие вещи и каталог совпадают без исключений. Рина физически изымала их."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "BEAT",
          "text": "The missing items and the catalog match without exception. Rina physically removed them."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "УПЭЎНЕНА",
          "text": "Зніклыя рэчы і каталог супадаюць без выключэнняў. Рына фізічна забірала іх."
        }
      }
    },
    {
      "id": "VN0788",
      "hidden": false,
      "background": "./assets/backgrounds/BG_OLD_ARCHIVE.webp",
      "actors": [
        {
          "character": "miku",
          "asset": "./assets/characters/miku/rig/pose_a/frames/frame-neutral.png",
          "x": 29,
          "top": 37.14,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "МИКУ",
          "emotion": "НА КОНТРОЛЬНУЮ ПОЛКУ",
          "text": "А случайные вещи не входят в список пилота и не содержат активных меток."
        },
        "en": {
          "speaker": "MIKU",
          "emotion": "BEAT",
          "text": "And the random items are not on the pilot list and contain no active tags."
        },
        "be": {
          "speaker": "МІКУ",
          "emotion": "НА КАНТРОЛЬНУЮ ПАЛІЦУ",
          "text": "А выпадковыя рэчы не ўваходзяць у спіс пілота і не ўтрымліваюць актыўных метак."
        }
      }
    },
    {
      "id": "VN0789",
      "hidden": false,
      "background": "./assets/backgrounds/BG_OLD_ARCHIVE.webp",
      "actors": [
        {
          "character": "rina",
          "asset": "./assets/characters/rina/rig/pose_a/frames/frame-neutral.png",
          "x": 71,
          "top": 38.31,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "РИНА",
          "emotion": "СУХО",
          "text": "Статистический шум. Чтобы критерий изъятия не стал очевиден сразу."
        },
        "en": {
          "speaker": "RINA",
          "emotion": "BEAT",
          "text": "Statistical noise. So the removal criterion would not become obvious immediately."
        },
        "be": {
          "speaker": "РЫНА",
          "emotion": "СУХА",
          "text": "Статыстычны шум. Каб крытэрый канфіскацыі не стаў відавочным адразу."
        }
      }
    },
    {
      "id": "VN0790",
      "hidden": false,
      "background": "./assets/backgrounds/BG_OLD_ARCHIVE.webp",
