          "top": 37.14,
          "height": 128.16,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 0
        }
      ],
      "localized": {
        "ru": {
          "speaker": "МИКУ",
          "emotion": "ОБРЫВАЕТ",
          "text": "Это чужие личные вещи. Хватит терминологии."
        },
        "en": {
          "speaker": "MIKU",
          "emotion": "BEAT",
          "text": "They are other people’s personal belongings. Enough terminology."
        },
        "be": {
          "speaker": "МІКУ",
          "emotion": "АБРЫВАЕ",
          "text": "Гэта чужыя асабістыя рэчы. Досыць тэрміналогіі."
        }
      }
    },
    {
      "id": "VN0793",
      "hidden": false,
      "background": "./assets/backgrounds/BG_OLD_ARCHIVE.webp",
      "actors": [
        {
