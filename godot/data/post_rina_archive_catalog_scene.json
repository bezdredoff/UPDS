        "en": {
          "speaker": "AYUKI",
          "emotion": "BEAT",
          "text": "So, camouflage underwear."
        },
        "be": {
          "speaker": "АЮКІ",
          "emotion": "НЕ СТРЫМАЛАСЯ",
          "text": "То бок маскіровачная бялізна."
