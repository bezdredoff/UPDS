      ],
      "localized": {
        "ru": {
          "speaker": "АЮКИ",
          "emotion": "ТИХО",
          "text": "Квартира, чужое бельё, швейная машина. Если это не финальная локация дела, я разочаруюсь."
        },
        "en": {
          "speaker": "AYUKI",
          "emotion": "QUIETLY",
          "text": "Apartment, other people’s underwear, sewing machine. If this is not the final location of the case, I will be disappointed."
        },
        "be": {
          "speaker": "АЮКІ",
          "emotion": "ЦІХА",
          "text": "Кватэра, чужая бялізна, швейная машына. Калі гэта не фінальная лакацыя справы, я расчаруюся."
