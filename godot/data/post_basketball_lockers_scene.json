        }
      ],
      "localized": {
        "ru": {
          "speaker": "МИКУ",
          "emotion": "МЯГЧЕ",
          "text": "Вы не обязаны приглашать нас домой."
        },
        "en": {
          "speaker": "MIKU",
          "emotion": "SOFTER",
          "text": "You are not required to invite us into your home."
        },
        "be": {
          "speaker": "МІКУ",
          "emotion": "МЯКЧЭЙ",
          "text": "Вы не абавязаныя запрашаць нас дадому."
        }
      }
    },
    {
      "id": "VN0322",
      "hidden": false,
      "background": "./assets/backgrounds/BG_BASKETBALL_LOCKER.webp",
      "actors": [
        {
          "character": "hinata",
          "asset": "./assets/guests/hinata/neutral.png",
          "x": 71,
          "top": 0,
          "height": 178,
          "compactHeight": 168,
          "scale": 1,
          "y": 0,
          "z": 2,
          "idle": false
        }
      ],
      "localized": {
        "ru": {
          "speaker": "ХИНАТА",
          "emotion": "СПОКОЙНО",
          "text": "Не обязана. Но команда уже шепчется. Мне выгоднее один аккуратный осмотр, чем неделя аккуратных слухов."
        },
        "en": {
          "speaker": "HINATA",
          "emotion": "CALMLY",
          "text": "I am not. But the team is already whispering. One careful inspection is better for me than a week of careful rumors."
        },
        "be": {
          "speaker": "ХІНАТА",
          "emotion": "СПАКОЙНА",
          "text": "Не абавязаная. Але каманда ўжо шэпчацца. Мне выгадней адзін акуратны агляд, чым тыдзень акуратных чутак."
        }
      }
    },
