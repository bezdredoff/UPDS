      "localized": {
        "ru": {
          "speaker": "ОНОЭ",
          "emotion": "СОСРЕДОТОЧЕННАЯ",
          "text": "Квитанция подтверждает одну партию. Но из неё исчезли только два предмета."
        },
        "en": {
          "speaker": "ONOE",
          "emotion": "FOCUSED",
          "text": "The receipt confirms one batch. But only two items disappeared from it."
        },
        "be": {
          "speaker": "ОНОЭ",
          "emotion": "ЗАСЯРОДЖАНАЯ",
          "text": "Квітанцыя пацвярджае адну партыю. Але з яе зніклі толькі два прадметы."
        }
      }
    },
    {
