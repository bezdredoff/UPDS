{
  "name": "class-u-detectives",
  "private": true,
  "version": "0.25.4-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests vite.config.ts",
    "format": "biome format --write src tests vite.config.ts",
    "format:check": "biome format src tests vite.config.ts",
    "check:fast": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "story:audit": "vitest run tests/StoryContentAudit.test.ts",
    "character:audit": "vitest run tests/CharacterProductionManifest.test.ts tests/CharacterArchiveAdoption.test.ts",
    "scene:audit": "vitest run tests/SceneStagingContract.test.ts tests/SceneStudioFoundation.test.ts",
    "localization:audit": "vitest run tests/LocalizationProductionContract.test.ts tests/BelarusianCompletionLocalization.test.ts tests/BelarusianMatch3Localization.test.ts tests/BelarusianVnLocalization.test.ts tests/LocalizationCompletionAudit.test.ts tests/ScreenplayLocalizationCompleteness.test.ts tests/Match3Localization.test.ts",
    "localization:be:audit": "vitest run tests/BelarusianCompletionLocalization.test.ts tests/BelarusianMatch3Localization.test.ts tests/BelarusianVnLocalization.test.ts",
    "docs:audit": "vitest run tests/DocumentationTraceability.test.ts",
    "tooling:audit": "vitest run tests/ToolingIdentityHardening.test.ts tests/VersionIdentity.test.ts tests/DocumentationTraceability.test.ts tests/RepositoryHygiene.test.ts",
    "security:audit": "npm audit --audit-level=high",
    "build": "tsc && vite build",
    "precheck": "npm run security:audit",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "e2e:install": "npm --prefix e2e install --ignore-scripts --package-lock=false",
    "e2e:install:chromium": "npm --prefix e2e exec -- playwright install chromium",
    "test:e2e": "npm --prefix e2e test",
    "test:e2e:chromium": "npm --prefix e2e run test:chromium",
    "e2e:report": "npm --prefix e2e run report",
    "lint:fix": "biome lint --write src tests vite.config.ts",
    "quality:fix": "biome check --write --formatter-enabled=false src tests vite.config.ts",
    "match3:audit": "vitest run --config vitest.match3-audit.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "typescript": "5.5.4",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
